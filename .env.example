# Jira Quick Access - Environment Variables Template
# Copy this file to .env and configure your Jira instances

# Jira Instance 1 (Default)
JIRA_BASE_URL=https://your-company.atlassian.net
JIRA_EMAIL=your-email@example.com
JIRA_API_TOKEN=your-atlassian-api-token
JIRA_JQL=assignee = currentUser() AND resolution = Unresolved ORDER BY updated DESC

# Additional Jira Instances (Optional)
# JIRA_INST2_NAME=Sandbox
# JIRA_INST2_URL=https://example.atlassian.net
# JIRA_INST2_EMAIL=user@sandbox.ch
# JIRA_INST2_TOKEN=token-here
# JIRA_INST2_JQL=assignee = currentUser() AND resolution = Unresolved ORDER BY updated DESC
